{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kasbsquall/xdr-shape-corpus/schema/manifest.schema.json",
  "title": "XDR shape corpus manifest (draft 0.1)",
  "description": "Language-neutral index of corpus entries. Each entry is one rare but valid ledger shape, stored as raw XDR files plus the values a correct decoder must produce.",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "caps", "protocolVersion", "network", "source", "synthetic", "shapes", "files", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable entry ID, e.g. cap40-signed-payload-signer-setoptions."
        },
        "caps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^CAP-[0-9]{4}$" },
          "description": "CAPs that introduced or changed the shape."
        },
        "protocolVersion": { "type": "integer", "minimum": 1, "description": "Ledger protocol version at capture time." },
        "network": {
          "type": "object",
          "required": ["passphrase"],
          "additionalProperties": false,
          "properties": {
            "name": { "enum": ["testnet", "mainnet", "local"] },
            "passphrase": { "type": "string" }
          }
        },
        "source": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["network-history", "local-core", "hand-crafted"] },
            "ledger": { "type": "integer", "minimum": 1 },
            "txHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "capturedVia": { "type": "string", "description": "e.g. stellar-rpc getTransaction + getLedgers" },
            "capturedAt": { "type": "string", "format": "date-time" },
            "generator": { "type": "string", "description": "Script and version that produced the entry." }
          }
        },
        "synthetic": { "type": "boolean", "description": "true when the bytes were not emitted by stellar-core." },
        "shapes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Shape tags, e.g. muxed-source, signed-payload-signer, sac-created-trustline, scmap-key-collision."
        },
        "sightings": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "description": "Public issues or PRs this entry reproduces or guards against."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "xdrType", "encoding", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "xdrType": {
                "type": "string",
                "description": "Name of the XDR type as in stellar-xdr, e.g. TransactionEnvelope, TransactionMeta, LedgerCloseMeta, ScVal."
              },
              "encoding": { "enum": ["base64", "raw"] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash of the decoded raw bytes." }
            }
          }
        },
        "expected": {
          "type": "object",
          "description": "Values a conforming decoder must produce. Keys are JSON Pointers into the stellar-xdr JSON (xdr-json) form of the file named in `file`.",
          "required": ["file", "values"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string" },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["pointer", "value"],
                "additionalProperties": false,
                "properties": {
                  "pointer": { "type": "string" },
                  "value": {},
                  "note": { "type": "string" }
                }
              }
            },
            "roundTrip": { "type": "boolean", "description": "Decoding then re-encoding must reproduce the original bytes." },
            "mustReject": { "type": "boolean", "description": "For negative entries: a conforming decoder must reject the bytes." }
          }
        },
        "checks": {
          "type": "object",
          "description": "Results of reference checks at generation time.",
          "additionalProperties": false,
          "properties": {
            "rsStellarXdrRoundTrip": { "type": "boolean" },
            "rsStellarXdrVersion": { "type": "string" },
            "checkLcmGolden": { "enum": ["agrees", "differs", "not-applicable", "not-run"] }
          }
        }
      }
    }
  }
}
